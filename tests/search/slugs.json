  { "about": "The text of the site's first language", "html": "<h2><span lang=\"pt\">Árvores</span><span lang=\"en\">Trees</span></h2>", "languages": ["pt", "en"], "ids": ["arvores"] },
  { "about": "A region language like en-GB counts as en", "html": "<h2><span lang=\"en-GB\">Colour</span> 1</h2>", "languages": ["pt", "en"], "ids": ["1"] },
