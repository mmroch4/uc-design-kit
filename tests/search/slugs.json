  { "about": "Accents are removed and spaces become hyphens", "html": "<h2>Exercício 2</h2>", "ids": ["exercicio-2"] },
  { "about": "A repeated slug gets -2, -3, …", "html": "<h2>A</h2><h2>A</h2><h3>A</h3>", "ids": ["a", "a-2", "a-3"] },
  { "about": "An id written in the HTML is taken, wherever it is", "html": "<h2>A</h2><h2 id=\"a\">x</h2>", "ids": ["a-2", "a"] },
