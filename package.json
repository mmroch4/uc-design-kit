{
  "name": "uc-design-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Maintainer tooling for the UC Design Kit. Teachers never need this.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "snapshot": "node scripts/snapshot.mjs",
    "snapshot:widgets": "node scripts/snapshot.mjs --widgets",
    "pretest": "node scripts/build.mjs",
    "test": "node --test tests/widgets/*.test.mjs && node scripts/check-docs.mjs --strict && node scripts/check-search.mjs && node scripts/check-a11y.mjs && node scripts/check-pages.mjs && node scripts/check-dom.mjs",
    "test:widgets": "node --test tests/widgets/*.test.mjs",
    "test:search": "node scripts/build.mjs && node scripts/check-search.mjs",
    "test:docs": "node scripts/check-docs.mjs",
    "test:update-screenshots": "node scripts/build.mjs && node scripts/check-pages.mjs --screenshots",
    "test:dom": "node scripts/build.mjs && node scripts/check-dom.mjs",
    "test:a11y": "node scripts/build.mjs && node scripts/check-a11y.mjs",
    "test:site-script": "python3 -m unittest discover -s tests/site-script"
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "esbuild": "0.24.2",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}
