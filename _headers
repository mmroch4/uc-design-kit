# Cloudflare Pages response headers.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Kit files keep stable URLs (kit/v1/...), so they are cached for a short time and then
# served from the browser cache while being revalidated in the background
# (stale-while-revalidate). Pages load without waiting for the server, and a new
# deploy reaches the browser on the next visit after max-age.

/kit/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, stale-while-revalidate=604800
  X-Content-Type-Options: nosniff

/examples/*/course.js
  Cache-Control: public, max-age=60, stale-while-revalidate=86400

/examples/*/theme.css
  Cache-Control: public, max-age=60, stale-while-revalidate=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
